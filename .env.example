# ── Agent (ECS Task environment variables) ────────────────────────────────────

# AWS region for Bedrock inference
AWS_REGION=us-east-1

# Bedrock model ID (Claude 3 Sonnet)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Port the FastAPI agent listens on
PORT=8080

# IAM role ARN the agent assumes for cross-account API calls.
# Use {account_id} as a placeholder — it will be substituted at runtime.
# Example: arn:aws:iam::{account_id}:role/IncidentResponseAgentRole
# Leave blank to use the ECS task execution role directly (single-account setup).
AGENT_ROLE_ARN=

# Account IDs for investigation targets
NETWORK_ACCOUNT_ID=111111111111
BUSINESS_ACCOUNT_ID=222222222222

# ── Lambda (Webhook trigger environment variables) ────────────────────────────

# URL of the agent ALB (http://<alb-dns>/investigate)
AGENT_URL=http://your-agent-alb-dns/investigate

# SES email addresses for incident notifications
EMAIL_SENDER=alerts@yourdomain.com
EMAIL_RECIPIENT=oncall@yourdomain.com

# AWS region for SES (must match where SES is configured)
SES_REGION=us-east-1

# ── Infrastructure (provisioning scripts) ────────────────────────────────────

# These are auto-detected from the ALB in the provisioning scripts.
# You do NOT need to set these manually.
# VPC_ID       — fetched from ALB describe output
# SUBNET_IDS   — fetched from ALB describe output
# ALB_SG_ID    — fetched from ALB describe output
